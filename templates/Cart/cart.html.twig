{% extends 'base.html.twig' %}

{% block title %}Shopping Cart{% endblock %}

{% block body %}
<div class="container my-5">
    <h1 class="mb-4">Shopping Cart</h1>

    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-body">
                    <table class="table align-middle">
                        <thead>
                        <tr>
                            <th>Product</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Total</th>
                            <th></th>
                        </tr>
                        </thead>

                        <tbody>
                        {% for item in cart.cartItems %}
                            <tr>
                                <td>
                                    <h6 class="mb-0">{{ item.product.name }}</h6>
                                    <small class="text-muted">{{ item.product.description }}</small>
                                </td>
                                <td>${{ item.price }}</td>
                                <td>{{ item.quantity }}</td>
                                <td class="fw-bold">${{ item.price * item.quantity }}</td>
                                <td>
                                    <a href="{{ path('cart_remove', {id: item.product.id}) }}" class="btn btn-sm btn-outline-danger">
                                        Remove
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center">Cart is empty</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            <a href="{{ path('products') }}" class="btn btn-outline-primary">
                ← Continue Shopping
            </a>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Order Summary</h5>
                </div>

                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal:</span>
                        <span>${{ cart.total() }}</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Shipping:</span>
                        <span>$10</span>
                    </div>

                    <hr>

                    <div class="d-flex justify-content-between mb-3">
                        <strong>Total:</strong>
                        <strong class="text-success">${{ cart.total() + 10 }}</strong>
                    </div>

                    <a href="{{ path('cart_clear') }}" class="btn btn-danger w-100 mb-2">
                        Clear Cart
                    </a>

                    <button class="btn btn-success w-100">
                        Proceed to Checkout
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}