{% extends 'base.html.twig' %}

{% block title %}{{ category.name }} - Our Store{% endblock %}

{% block body %}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="{{ path('products') }}" class="text-decoration-none">Home</a>
            </li>

            <li class="breadcrumb-item active">
                {{ category.name }}
            </li>
        </ol>
    </nav>
</div>

<div class="container my-4">
    <div class="p-5 mb-4 bg-primary bg-gradient text-white rounded-3">
        <div class="container-fluid py-3">
            <h1>{{ category.name }}</h1>

            <p class="col-md-8 fs-5">
                {{ category.description ?? 'Discover the latest products in this category.' }}
            </p>

            <span class="badge bg-light text-dark fs-6">
                {{ products|length }} Products Available
            </span>
        </div>
    </div>
</div>

<div class="container mb-5">
    <div class="row mb-4">
        <div class="col">
            <h3>Browse {{ category.name }}</h3>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">

        {% for product in products %}
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img src="{{ asset('mouse.png') }}" class="card-img-top" alt="Produit">

                    <div class="card-body">
                        <span class="badge bg-primary mb-2">
                            {{ product.category.name }}
                        </span>

                        <h5 class="card-title">
                            {{ product.name }}
                        </h5>

                        <p class="card-text fw-bold text-success">
                            ${{ product.price }}
                        </p>

                        <a href="{{ path('product_details', {'id': product.id}) }}" class="btn btn-outline-primary">
                            View Details
                        </a>
                    </div>
                </div>
            </div>
        {% endfor %}

    </div>
</div>

{% endblock %}