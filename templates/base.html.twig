<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Our Store{% endblock %}</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    {% block stylesheets %}{% endblock %}
</head>

<body>

{% set currentRoute = app.request.attributes.get('_route') %}

{% if currentRoute not in ['app_login', 'app_register'] %}

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">

        <a class="navbar-brand" href="{{ path('products') }}">
            Our Store
        </a>

        <div class="collapse navbar-collapse">

            <ul class="navbar-nav ms-auto">

                <li class="nav-item">
                    <a class="nav-link" href="{{ path('products') }}">
                        Products
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="{{ path('cart_show') }}">
                        Cart
                    </a>
                </li>

                {% if app.user %}
                    <li class="nav-item">
                        <span class="nav-link">
                            Bienvenue, {{ app.user.nom }}
                        </span>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_logout') }}">
                            Logout
                        </a>
                    </li>
                {% endif %}

            </ul>

        </div>
    </div>
</nav>

{% endif %}

{% block body %}{% endblock %}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

{% block javascripts %}{% endblock %}

</body>
</html>